# DEMO / TEST ENVIRONMENT ONLY — never use production banking secrets.

# PostgreSQL
POSTGRES_DB=banking
POSTGRES_USER=banking
POSTGRES_PASSWORD=change-me-demo-db-password

# Backend
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://postgres:5432/banking
DB_USERNAME=banking
DB_PASSWORD=change-me-demo-db-password
SERVER_PORT=8080

# At least 32 characters. Do not commit the real value.
JWT_SECRET=change-me-to-a-long-random-demo-jwt-secret-32+

# Frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8080
